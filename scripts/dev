#!/bin/zsh
set -eu

SCRIPT_DIR=${0:A:h}
PROJECT_ROOT=${SCRIPT_DIR:h}
NODE_BIN=${PHOTO_MENTOR_NODE_BIN:-$(command -v node || true)}
ENV_FILE=$PROJECT_ROOT/experiments/ai-analysis-eval/.env
PORT=${PHOTO_MENTOR_LOCAL_PORT:-4174}

if [[ -z $NODE_BIN || ! -x $NODE_BIN ]]; then
  echo "找不到 Node.js，请先安装 Node.js 24 或设置 PHOTO_MENTOR_NODE_BIN。"
  exit 1
fi

if [[ -f $ENV_FILE ]]; then
  set -a
  source $ENV_FILE
  set +a
else
  echo "未找到 $ENV_FILE；界面仍可启动，但模型分析需要配置 PHOTO_MENTOR_API_KEY、DEEPSEEK_API_KEY 或 DASHSCOPE_API_KEY。"
fi

echo "暗房本地版：http://127.0.0.1:$PORT"
exec $NODE_BIN $PROJECT_ROOT/apps/web/node_modules/next/dist/bin/next dev $PROJECT_ROOT/apps/web \
  --hostname 127.0.0.1 --port $PORT
