# 默认使用 DashScope/Qwen；切换到 DeepSeek 时，把下面的 PHOTO_MENTOR_PROVIDER 改为 deepseek。
# 模型选择通过环境变量完成，不需要把模型名或 API Key 写进业务代码。
DASHSCOPE_API_KEY=请填入你自己的百炼普通APIKey
# 可选：如果创建 API Key 时百炼提供了专属 API Host，可填入完整兼容协议地址
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：默认固定使用此模型，不建议在首轮测试中使用 latest
# PHOTO_MENTOR_MODEL=qwen3.7-plus-2026-05-26

# DeepSeek Flash（视觉输入使用同一个 deepseek-flash 模型）
# PHOTO_MENTOR_PROVIDER=deepseek
# PHOTO_MENTOR_API_KEY=请填入你的 DeepSeek API Key
# 或者只填写 DEEPSEEK_API_KEY，程序会按供应商自动读取
# DEEPSEEK_API_KEY=请填入你的 DeepSeek API Key
# PHOTO_MENTOR_BASE_URL=https://api.deepseek.com
# PHOTO_MENTOR_MODEL=deepseek-flash

# 为了首轮响应更快，DeepSeek 默认关闭思考模式；需要时再改为 true。
# PHOTO_MENTOR_ENABLE_THINKING=false
